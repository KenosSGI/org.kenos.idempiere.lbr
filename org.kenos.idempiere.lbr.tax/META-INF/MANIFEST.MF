Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: LBR Tax Core
Bundle-SymbolicName: org.kenos.idempiere.lbr.tax;singleton:=true
Bundle-Version: 6.2.0.qualifier
Require-Bundle: org.adempiere.base;bundle-version="6.2.0",
 org.adempiere.base.process;bundle-version="6.2.0",
 org.kenos.idempiere.lbr.base;bundle-version="1.0.0",
 org.eclipse.osgi.services,
 com.fasterxml.jackson.core.jackson-core,
 com.fasterxml.jackson.core.jackson-annotations,
 com.fasterxml.jackson.core.jackson-databind
Eclipse-RegisterBuddy: org.adempiere.base
Service-Component: OSGI-INF/*.xml
Export-Package: org.adempierelbr.model,
 org.adempierelbr.validator,
 org.kenos.idempiere.lbr.tax.ibpt,
 org.kenos.idempiere.lbr.tax.lookup,
 org.kenos.idempiere.lbr.tax.model,
 org.kenos.idempiere.lbr.tax.validation
Bundle-ClassPath: .,
 lib/xmlbeans.jar,
 lib/converter-jackson.jar,
 lib/kotlin-stdlib.jar,
 lib/logging-interceptor.jar,
 lib/okhttp3.jar,
 lib/okio-jvm.jar,
 lib/retrofit.jar
Bundle-ActivationPolicy: lazy
Automatic-Module-Name: org.kenos.idempiere.lbr.tax
Bundle-RequiredExecutionEnvironment: JavaSE-11
Bundle-Vendor: Kenos www.kenos.com.br
