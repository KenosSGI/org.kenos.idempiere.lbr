<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry exported="true" kind="lib" path="lib/converter-jackson.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/kotlin-stdlib.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/logging-interceptor.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/okhttp3.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/okio-jvm.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/retrofit.jar"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-11">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins">
		<accessrules>
			<accessrule kind="accessible" pattern="org/osgi/service/event/*"/>
		</accessrules>
	</classpathentry>
	<classpathentry kind="src" path="src/"/>
	<classpathentry exported="true" kind="lib" path="lib/xmlbeans.jar"/>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
